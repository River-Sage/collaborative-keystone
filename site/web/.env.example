# Local development
VITE_API_BASE_URL=http://localhost:8080
# Opt in only for local demos. Do not enable on public deployments.
# VITE_SHOW_PROTOTYPE_ACCOUNTS=true
# Optional production human-check widget. Pair with CF_TURNSTILE_SECRET_KEY on the API.
# VITE_TURNSTILE_SITE_KEY=
# Optional World Keystone-only support link.
# VITE_PATREON_URL=https://www.patreon.com/worldkeystone
# VITE_PATREON_LABEL=Buy the creator a coffee ☕

# Production example when the API is exposed separately through Cloudflare Tunnel.
# Set this before running the production web build.
# VITE_API_BASE_URL=https://api.worldkeystone.com
