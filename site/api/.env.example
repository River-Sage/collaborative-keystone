# Local development
DATABASE_URL=postgres://ck_app:change-me@localhost:5432/collaborative_keystone_dev
HOST=127.0.0.1
PORT=8080
RUST_LOG=api=debug,tower_http=debug

# Development helpers. Leave these off in production.
CK_EXPOSE_DEV_AUTH_TOKENS=true
CK_SEED_DEV_ACCOUNTS=true

# First-moderator bootstrap. Use only on fresh deployments before a moderator
# exists, set a random 32+ character token, then remove it after use.
# CK_BOOTSTRAP_MODERATOR_TOKEN=

# Email delivery. Local development logs emails to the API logs instead of
# sending real inbox messages. In debug/dev mode, verification and reset tokens
# may also be returned to the web UI for local testing.
MAIL_MODE=log
MAIL_FROM_NAME='World Keystone'
MAIL_FROM_EMAIL=no-reply@worldkeystone.com
PUBLIC_WEB_ORIGIN=http://localhost:5173
PUBLIC_API_ORIGIN=http://localhost:8080

# Optional Cloudflare Turnstile protection for public registration and password
# reset requests. Pair this server secret with VITE_TURNSTILE_SITE_KEY in the
# web build.
# CF_TURNSTILE_SECRET_KEY=

# Public source/provenance metadata. Development may leave release/signature
# fields blank; production release tooling should populate them.
CK_SOURCE_REPOSITORY_URL=https://github.com/River-Sage/collaborative-keystone
CK_DEPLOYMENT_KIND=local
CK_DEPLOYMENT_STATUS=development
CK_REGISTRY_STATUS=development
CK_TRUST_TIER=development
CK_GLOBAL_REGISTRY_ORIGIN=http://localhost:5173
CK_LOCALE_SLUG=world
CK_LOCALE_NAME=World
CK_LOCALE_TYPE=world
# World/registry deployments may list known locale instances as JSON. Locale
# instances may leave this unset and self-report only.
# CK_LOCALE_REGISTRY_JSON=[{"locale":{"slug":"castle-rock","name":"Castle Rock","locale_type":"municipality"},"web_origin":"https://castle-rock.example.test","api_origin":"https://api.castle-rock.example.test","operator":{"name":"Castle Rock operator","contact":"ops@example.test"},"registry_status":"authorized","trust_tier":"signed-release","release_id":"v0.1.0","source_repository_url":"https://github.com/River-Sage/collaborative-keystone","provenance_manifest_path":"/.well-known/keystone-build.json","instance_public_key":null,"last_verified_at":null}]
# CK_OPERATOR_NAME=
# CK_OPERATOR_CONTACT=
# CK_GIT_COMMIT_SHA=
# CK_RELEASE_ID=
# CK_BUILD_TIMESTAMP=
# CK_BUILD_ENVIRONMENT=
# CK_WEB_ARTIFACT_DIGEST=
# CK_API_ARTIFACT_DIGEST=
# CK_MIGRATION_SET_DIGEST=
# CK_CONFIGURATION_DIGEST=
# CK_PROVENANCE_SIGNATURE=
# CK_PUBLIC_VERIFICATION_KEY=
# CK_INSTANCE_PUBLIC_KEY=
# CK_LAST_VERIFIED_AT=

# Production example for a Cloudflare Tunnel deployment.
# Prefer setting these in the service environment rather than committing a real .env.
# APP_ENV=production
# DATABASE_URL=postgres://ck_app:change-me@localhost:5432/collaborative_keystone_prod
# HOST=127.0.0.1
# PORT=8080
# WEB_ORIGIN=https://worldkeystone.com
# CORS_ALLOWED_ORIGINS=https://worldkeystone.com
# CK_EXPOSE_DEV_AUTH_TOKENS=false
# CK_SEED_DEV_ACCOUNTS=false
# CK_BOOTSTRAP_MODERATOR_TOKEN=
# PUBLIC_WEB_ORIGIN=https://worldkeystone.com
# PUBLIC_API_ORIGIN=https://api.worldkeystone.com
# CK_SOURCE_REPOSITORY_URL=https://github.com/River-Sage/collaborative-keystone
# CK_DEPLOYMENT_KIND=canonical
# CK_DEPLOYMENT_STATUS=canonical
# CK_REGISTRY_STATUS=canonical
# CK_TRUST_TIER=signed-release
# CK_GLOBAL_REGISTRY_ORIGIN=https://worldkeystone.com
# CK_LOCALE_SLUG=world
# CK_LOCALE_NAME=World
# CK_LOCALE_TYPE=world
# CK_LOCALE_REGISTRY_JSON=
# CK_OPERATOR_NAME='Global Keystone'
# CK_OPERATOR_CONTACT=ops@worldkeystone.com
# CK_GIT_COMMIT_SHA=
# CK_RELEASE_ID=
# CK_BUILD_TIMESTAMP=
# CK_BUILD_ENVIRONMENT=production
# CK_WEB_ARTIFACT_DIGEST=
# CK_API_ARTIFACT_DIGEST=
# CK_MIGRATION_SET_DIGEST=
# CK_CONFIGURATION_DIGEST=
# CK_PROVENANCE_SIGNATURE=
# CK_PUBLIC_VERIFICATION_KEY=
# MAIL_MODE=resend
# MAIL_FROM_NAME='World Keystone'
# MAIL_FROM_EMAIL=no-reply@worldkeystone.com
# MAIL_RESEND_API_KEY=
# MAIL_RESEND_API_URL=https://api.resend.com/emails
# Optional SMTP fallback. Some VPS providers block outbound SMTP ports.
# MAIL_SMTP_HOST=smtp.resend.com
# MAIL_SMTP_PORT=465
# MAIL_SMTP_SECURITY=implicit_tls
# MAIL_SMTP_USERNAME=resend
# MAIL_SMTP_PASSWORD=
# MAIL_SMTP_HELO_NAME=worldkeystone.com
# CF_TURNSTILE_SECRET_KEY=
